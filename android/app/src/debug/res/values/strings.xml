<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds keep a distinct launcher name. With android/fork.properties the id is
  com.noop.whoop.ita.debug, so this build installs beside both official NOOP (com.noop.whoop)
  and the fork release (com.noop.whoop.ita). Build-type source set wins over main/flavor, so
  assembleFullDebug shows "NOOP IT Debug".
-->
<resources>
    <string name="app_name">NOOP IT Debug</string>
</resources>
